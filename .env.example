# Copy to .env for local (non-Docker) development.
# Never commit a real .env file.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_db
JWT_SECRET=change-me-in-class
JWT_EXPIRES_IN=7d
PORT=5000
CORS_ORIGIN=http://localhost:3000

# DEVELOPMENT DEFAULT admin — override these in production
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin@123
ADMIN_ROLE=admin
